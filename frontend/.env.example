# Copy to .env.local (git-ignored) for local development, or set in Vercel project settings.
# Server-side only. Never prefix with VITE_, which would expose it to the browser.
ELEVENLABS_API_KEY=

# Optional: speech-to-text model (default scribe_v1)
# ELEVENLABS_STT_MODEL=scribe_v1

# Optional: 311 Assistant voice replies (text-to-speech). Uses ELEVENLABS_API_KEY.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb          # any voice ID from your ElevenLabs library
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_TTS_MODEL_EXTENDED=eleven_v3          # for Urdu, Punjabi, Gujarati, Bengali, Vietnamese, Cantonese

# 311 Assistant conversation: a language model on Groq (https://console.groq.com/keys).
# Server-side only, like the key above. Without it the assistant runs its simple fixed-reply flow.
GROQ_API_KEY=

# Optional: models, tried in order (each has its own free-tier limits)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Optional: secret that signs the assistant's replies before they are spoken (default: derived from the ElevenLabs key)
# ASSISTANT_SIGNING_SECRET=
